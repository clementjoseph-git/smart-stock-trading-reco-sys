# Environment selector
# Options: development, staging, production
REACT_APP_ENV=development

# API base URLs
REACT_APP_API_BASE_URL_DEV=http://127.0.0.1:8000
REACT_APP_API_BASE_URL_STAGING=https://staging.smartstocktrading.com/api
REACT_APP_API_BASE_URL_PROD=https://smartstocktrading.com/api

# Hosted Hugging Face inference is configured on the backend, not in the browser.
