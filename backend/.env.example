# Server-side Hugging Face token. Never expose this in the web client.
HF_API_TOKEN=replace-with-server-side-token

# Verified serverless text-classification model.
HF_SENTIMENT_MODEL=ProsusAI/finbert

# Chronos model artifact. The model card currently requires a dedicated
# Hugging Face Endpoint rather than a serverless Inference Provider.
HF_FORECAST_MODEL=amazon/chronos-t5-tiny
HF_FORECAST_ENDPOINT=https://<your-forecast-endpoint>.endpoints.huggingface.cloud
HF_FORECAST_HORIZON=5

# No universal hosted tabular-regression model is selected. Deploy a model
# trained for this project's fundamentals feature schema.
HF_FUNDAMENTALS_MODEL=<your-org>/<fundamentals-model>
HF_FUNDAMENTALS_ENDPOINT=https://<your-fundamentals-endpoint>.endpoints.huggingface.cloud